{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.wheel/hooks/checkpoint.py\" sessionstart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.wheel/hooks/track_write.py\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.wheel/hooks/turnsave.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.wheel/hooks/checkpoint.py\" precompact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.wheel/hooks/guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ],
    "allow": [
      "Bash(node scripts/lug-verb.js *)",
      "Bash(node scripts/lug-divergence.js *)",
      "Bash(node scripts/readiness-sweep.js*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(node scripts/push-bypass.js *)",
      "Bash(hf deploy --stage=push,cut)",
      "Bash(node src/cli.js deploy --stage=push,cut)",
      "Bash(node scripts/ff-main.js *)",
      "Bash(node scripts/worktree.js *)",
      "Bash(node scripts/release-dead-lock.js *)",
      "Bash(node scripts/grant-scope.js *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.wheel/hooks/statusline.sh\""
  }
}