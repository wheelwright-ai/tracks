#!/usr/bin/env bash
# WAI pre-commit hook (Fable MR-2) — block secrets before they enter git history.
# Installed by tools/install_git_hooks.py (sets core.hooksPath to this dir, or copies here).
# Bypass a single commit with `git commit --no-verify` (use sparingly, and rotate if real).
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Locate the managed tools dir across harness layouts (v4 first, then v3, then flat).
scanner=""
for cand in \
  "$repo_root/WAI-Harness/spoke/managed/tools/secret_precommit_scan.py" \
  "$repo_root/tools/secret_precommit_scan.py" \
  "$repo_root/WAI-Spoke/tools/secret_precommit_scan.py"; do
  if [ -f "$cand" ]; then scanner="$cand"; break; fi
done

rc=0
if [ -n "$scanner" ]; then
  python3 "$scanner" --staged || rc=1
else
  echo "WAI pre-commit: secret_precommit_scan.py not found — secret scan SKIPPED." >&2
fi

# Manifest integrity (blocking): a staged managed/ edit without a MANIFEST recut
# strands the fleet on distribution ("corrupt master") — catch it here, not at push.
manifest_gate=""
for cand in \
  "$repo_root/WAI-Harness/spoke/managed/tools/manifest_integrity_precommit.py" \
  "$repo_root/tools/manifest_integrity_precommit.py"; do
  if [ -f "$cand" ]; then manifest_gate="$cand"; break; fi
done
if [ -n "$manifest_gate" ]; then
  python3 "$manifest_gate" --repo-root "$repo_root" || rc=1
fi

# Master authority (blocking): only the spoke that AUTHORS the harness may edit its
# distributed source. Every other spoke phones home with a change-lug. The rule lived
# in CLAUDE.md and nothing read it -- every spoke carries is_master:false and on
# 2026-08-17 no hook, tool or test used that field to refuse anything, so the only
# thing preventing a private fork of the harness was an agent remembering a paragraph.
# Delivering a lug to a sibling stays UNGATED: that is the sanctioned channel, and the
# opposite of the violation this blocks.
master_gate="$repo_root/WAI-Harness/spoke/managed/tools/master_authority_gate.py"
if [ -f "$master_gate" ]; then
  python3 "$master_gate" --root "$repo_root" || rc=1
fi

# Chain the existing health gate if present (non-fatal: it guards drift, not secrets).
health=""
for cand in \
  "$repo_root/WAI-Harness/spoke/managed/tools/pre_commit_health.py" \
  "$repo_root/tools/pre_commit_health.py"; do
  if [ -f "$cand" ]; then health="$cand"; break; fi
done
if [ -n "$health" ]; then
  python3 "$health" --spoke-path "$repo_root" || echo "WAI pre-commit: health gate reported drift (non-blocking)." >&2
fi

# Lug JSON parse gate (blocking): a conflicted/unparseable lugs/bytype/*.json must
# never land on main — impl-lug-json-parse-gate-v1. Called standalone because the
# health gate above is intentionally non-blocking and would otherwise swallow this.
lug_parse_gate=""
for cand in \
  "$repo_root/WAI-Harness/spoke/managed/tools/lug_json_parse_gate.py" \
  "$repo_root/tools/lug_json_parse_gate.py"; do
  if [ -f "$cand" ]; then lug_parse_gate="$cand"; break; fi
done
if [ -n "$lug_parse_gate" ]; then
  python3 "$lug_parse_gate" --root "$repo_root" || rc=1
fi

# THE CODE GRAPH IS RE-DERIVED FOR WHAT THIS COMMIT TOUCHES.
#
# This is the activation path for the code_node kind. `wai check` refuses a graph that has
# stopped describing the code, and pre-push runs check unconditionally -- so without this
# line a spoke goes stale on its FIRST commit after install and then cannot commit or push
# until somebody runs a command nothing told them about.
#
# MEASURED on mywheel s141: the previous graph sat twelve days stale, covering 0 of 1,254
# python files, while every dashboard reported it healthy. It was not wrong; nothing ran it.
# A producer with no runner is the defect this whole object model exists to end, and
# shipping the model without shipping its runner would reproduce that failure on every
# spoke the cut reaches.
#
# INCREMENTAL ON PURPOSE. A full walk is under a second on a large repo, but an incremental
# pass must never SWEEP -- it has not looked at the rest of the tree, so it cannot conclude
# anything about it. `wai derive --only` enforces that distinction.
#
# DEGRADES QUIETLY. A spoke that has not vendored the kernel yet simply skips this; the
# commit is not blocked by the absence of a graph, only by a graph that has gone wrong.
kernel_dir=""
for cand in "$repo_root/WAI-Harness/kernel" "$repo_root/WAI-Spoke/kernel"; do
  if [ -f "$cand/cli.py" ]; then kernel_dir="$(dirname "$cand")"; break; fi
done
if [ -n "$kernel_dir" ]; then
  staged_src="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|sh)$' || true)"
  if [ -n "$staged_src" ]; then
    derive_args=""
    while IFS= read -r f; do
      [ -n "$f" ] && derive_args="$derive_args --only $f"
    done <<< "$staged_src"
    # shellcheck disable=SC2086
    if (cd "$kernel_dir" && timeout 60 python3 -m kernel.cli --root "$repo_root" derive $derive_args >/dev/null 2>&1); then
      git add "$repo_root/WAI-Spoke/graph/code_node.jsonl" 2>/dev/null || true
      git add "$repo_root/WAI-Spoke/graph/initiative.jsonl" 2>/dev/null || true
    else
      echo "WAI pre-commit: could not re-derive the code graph — run \`wai derive\`." >&2
      rc=1
    fi
  fi
fi

if [ "$rc" -ne 0 ]; then
  echo "WAI pre-commit: commit blocked (secret scan and/or manifest integrity and/or lug parse gate and/or code graph above). Bypass with --no-verify (sparingly)." >&2
fi
exit "$rc"
